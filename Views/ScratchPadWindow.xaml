<Window x:Class="Effortless.Views.ScratchPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scratch Pad"
        Height="500"
        Width="600"
        MinHeight="200"
        MinWidth="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Dark scrollbar style -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Margin="0,4,0,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                                    Background="{DynamicResource ScrollbarThumbBrush}"
                                                                    CornerRadius="2"
                                                                    Opacity="0.6"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollbarThumbHoverBrush}"/>
                                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollbarThumbDragBrush}"/>
                                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource DarkScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title-bar text button -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SunkenBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hidden popup formatting toolbar (appears when text is selected) -->
        <Style x:Key="PopupToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SunkenBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupSwatch" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.5"
                              Direction="270"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar: centered editable document title (Google-Docs style),
                 hamburger + close on the right. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="12,6"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Centered title (display ↔ edit) -->
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MaxWidth="380">
                        <TextBlock x:Name="TitleDisplay"
                                   Text="Untitled"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Cursor="IBeam"
                                   Padding="8,4"
                                   MouseLeftButtonDown="TitleDisplay_Click"
                                   ToolTip="Click to rename"/>
                        <TextBox x:Name="TitleEdit"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="Transparent"
                                 CaretBrush="{DynamicResource CaretBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="0,0,0,1"
                                 FontFamily="Segoe UI"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Padding="8,3"
                                 MinWidth="220"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 PreviewKeyDown="TitleEdit_PreviewKeyDown"
                                 LostKeyboardFocus="TitleEdit_LostKeyboardFocus"/>
                    </Grid>

                    <!-- Hamburger + Close (right) -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Transient status (rare, kept compact) -->
                        <TextBlock x:Name="StatusText"
                                   Text=""
                                   Foreground="{DynamicResource AccentGreenBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="MenuButton"
                                Click="MenuButton_Click"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Menu">
                            <TextBlock Text="≡" FontSize="16" Margin="0,-3,0,0"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✦ Ask"          Click="AskButton_Click"/>
                                    <MenuItem Header="⬇ Vault"        Click="VaultButton_Click"/>
                                    <MenuItem Header="☰ Vault Browser" Click="BrowseButton_Click"/>
                                    <MenuItem Header="⤤ Open Folder"   Click="OpenFolderButton_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="SpellCheckMenuItem"
                                              Header="Spell check"
                                              IsCheckable="True"
                                              Click="SpellCheck_Click"/>
                                    <MenuItem x:Name="ThemeMenuItem"
                                              Header="Switch to light"
                                              Click="ThemeToggle_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Click="CloseButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,3"
                                Margin="2,0,0,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentRedBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="×" Foreground="{DynamicResource TextDimBrush}" FontSize="14" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Note content -->
            <RichTextBox Grid.Row="1"
                         x:Name="RichEditor"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Background="{DynamicResource WindowBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource CaretBrush}"
                         BorderThickness="0"
                         Padding="20,16"
                         FontFamily="Segoe UI"
                         FontSize="{Binding EditorFontSize}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="RichEditor_TextChanged"
                         SelectionChanged="RichEditor_SelectionChanged"
                         ContextMenuOpening="RichEditor_ContextMenuOpening">
                <RichTextBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Bold"   InputGestureText="Ctrl+B" Click="Bold_Click"/>
                        <MenuItem Header="Italic" InputGestureText="Ctrl+I" Click="Italic_Click"/>
                        <MenuItem Header="Highlight">
                            <MenuItem Header="Yellow" Click="Highlight_Click" Tag="#FFF59D"/>
                            <MenuItem Header="Green"  Click="Highlight_Click" Tag="#C8E6C9"/>
                            <MenuItem Header="Blue"   Click="Highlight_Click" Tag="#BBDEFB"/>
                            <MenuItem Header="Pink"   Click="Highlight_Click" Tag="#F8BBD0"/>
                            <Separator/>
                            <MenuItem Header="Remove highlight" Click="ClearHighlight_Click"/>
                        </MenuItem>
                        <MenuItem Header="Toggle task" Click="Task_Click"/>
                        <Separator/>
                        <MenuItem Command="ApplicationCommands.Cut"/>
                        <MenuItem Command="ApplicationCommands.Copy"/>
                        <MenuItem Command="ApplicationCommands.Paste"/>
                    </ContextMenu>
                </RichTextBox.ContextMenu>
            </RichTextBox>

            <!-- Floating selection toolbar (positioned on selection in code-behind) -->
            <Popup x:Name="SelectionToolbar"
                   Placement="Absolute"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource ChromeBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4,3">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PopupToolButton}" Click="Bold_Click" ToolTip="Bold (Ctrl+B)">
                            <TextBlock Text="B" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource PopupToolButton}" Click="Italic_Click" ToolTip="Italic (Ctrl+I)">
                            <TextBlock Text="I" FontStyle="Italic"/>
                        </Button>
                        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}"/>
                        <Button Style="{StaticResource PopupSwatch}" Click="Highlight_Click" Tag="#FFF59D"
                                Background="#FFF59D" ToolTip="Yellow"/>
                        <Button Style="{StaticResource PopupSwatch}" Click="Highlight_Click" Tag="#C8E6C9"
                                Background="#C8E6C9" ToolTip="Green"/>
                        <Button Style="{StaticResource PopupSwatch}" Click="Highlight_Click" Tag="#BBDEFB"
                                Background="#BBDEFB" ToolTip="Blue"/>
                        <Button Style="{StaticResource PopupSwatch}" Click="Highlight_Click" Tag="#F8BBD0"
                                Background="#F8BBD0" ToolTip="Pink"/>
                        <Button Style="{StaticResource PopupToolButton}" Click="ClearHighlight_Click"
                                ToolTip="Remove highlight" Margin="4,0,0,0">
                            <TextBlock Text="✕" FontSize="11"/>
                        </Button>
                        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}"/>
                        <Button Style="{StaticResource PopupToolButton}" Click="Task_Click" ToolTip="Toggle task (checkbox)">
                            <TextBlock Text="☑" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
