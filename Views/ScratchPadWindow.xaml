<Window x:Class="Effortless.Views.ScratchPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scratch Pad"
        Height="500"
        Width="600"
        MinHeight="200"
        MinWidth="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Dark scrollbar style -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Margin="0,4,0,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                                    Background="{DynamicResource ScrollbarThumbBrush}"
                                                                    CornerRadius="2"
                                                                    Opacity="0.6"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollbarThumbHoverBrush}"/>
                                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollbarThumbDragBrush}"/>
                                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource DarkScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title-bar text button -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SunkenBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Formatting toolbar button -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SunkenBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Highlight color swatch -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.5"
                              Direction="270"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <TextBlock Text="Scratch Pad"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <!-- Transient status / confirmation -->
                        <TextBlock x:Name="StatusText"
                                   Text=""
                                   Foreground="{DynamicResource AccentGreenBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Ask Claude about this pad -->
                        <Button Click="AskButton_Click"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Ask Claude about this scratch pad">
                            <TextBlock Text="✦ Ask"/>
                        </Button>
                        <!-- Vault current thought + start fresh -->
                        <Button Click="VaultButton_Click"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Vault this thought and start a fresh pad (/vault)">
                            <TextBlock Text="⬇ Vault"/>
                        </Button>
                        <!-- Browse vaulted thoughts -->
                        <Button Click="BrowseButton_Click"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Browse the thought vault">
                            <TextBlock Text="☰ Vault Browser"/>
                        </Button>
                        <!-- Open vault folder in Explorer -->
                        <Button Click="OpenFolderButton_Click"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Open the vault folder">
                            <TextBlock Text="⤤"/>
                        </Button>
                        <!-- Light/Dark toggle -->
                        <Button x:Name="ThemeToggle"
                                Click="ThemeToggle_Click"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Toggle light/dark theme">
                            <TextBlock x:Name="ThemeToggleGlyph"
                                       Text="&#xE706;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13"/>
                        </Button>
                        <!-- Close button -->
                        <Button Click="CloseButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,3"
                                Margin="2,0,0,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentRedBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="×" Foreground="{DynamicResource TextDimBrush}" FontSize="14" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Formatting toolbar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ChromeBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="10,5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Click="Bold_Click" ToolTip="Bold (Ctrl+B)">
                        <TextBlock Text="B" FontWeight="Bold"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Italic_Click" ToolTip="Italic (Ctrl+I)">
                        <TextBlock Text="I" FontStyle="Italic"/>
                    </Button>

                    <Border Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}"/>

                    <TextBlock Text="Highlight"
                               Foreground="{DynamicResource TextDimBrush}"
                               FontFamily="Segoe UI" FontSize="11"
                               VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <Button Style="{StaticResource Swatch}" Click="Highlight_Click" Tag="#FFF59D"
                            Background="#FFF59D" ToolTip="Yellow"/>
                    <Button Style="{StaticResource Swatch}" Click="Highlight_Click" Tag="#C8E6C9"
                            Background="#C8E6C9" ToolTip="Green"/>
                    <Button Style="{StaticResource Swatch}" Click="Highlight_Click" Tag="#BBDEFB"
                            Background="#BBDEFB" ToolTip="Blue"/>
                    <Button Style="{StaticResource Swatch}" Click="Highlight_Click" Tag="#F8BBD0"
                            Background="#F8BBD0" ToolTip="Pink"/>
                    <Button Style="{StaticResource ToolbarButton}" Click="ClearHighlight_Click"
                            ToolTip="Remove highlight" Margin="4,0,0,0">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>

                    <Border Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}"/>

                    <Button Style="{StaticResource ToolbarButton}" Click="Task_Click" ToolTip="Toggle checkbox / task line">
                        <TextBlock Text="☑ Task" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Note content -->
            <RichTextBox Grid.Row="2"
                         x:Name="RichEditor"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Background="{DynamicResource WindowBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource CaretBrush}"
                         BorderThickness="0"
                         Padding="16,12"
                         FontFamily="Segoe UI"
                         FontSize="{Binding EditorFontSize}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         SpellCheck.IsEnabled="True"
                         TextChanged="RichEditor_TextChanged">
                <RichTextBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Grid>
    </Border>
</Window>
